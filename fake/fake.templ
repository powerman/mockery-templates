{{- /*
	Generates stateful fakes with an own evolving API derived from go-mockgen.
	Keep it structurally aligned with go-mockgen.templ, so shared fixes apply to both.
	Generated API and naming rules are documented in package fake (doc.go).
*/ -}}
// Code generated by mockery; DO NOT EDIT.
// github.com/vektra/mockery
// template: fake (github.com/powerman/mockery-templates)

package {{.PkgName}}

{{- $sync := "sync" }}
{{- if .Interfaces.ImplementsSomeMethod }}
	{{- $sync = (.Registry.AddImport "sync" "sync").Qualifier }}
{{- end }}
{{- $src := "" }}
{{- with .Registry.AddImport .Registry.SrcPkgName .Registry.SrcPkg.PkgPath }}
	{{- $src = printf "%s." .Qualifier }}
{{- end }}

import (
{{- range .Imports }}
	{{ .ImportStatement }}
{{- end }}
)

{{- define "ordinal" }}
	{{- $suffix := "th" }}
	{{- $tens := mod . 100 }}
	{{- if and (ne $tens 11) (ne $tens 12) (ne $tens 13) }}
		{{- $ones := mod . 10 }}
		{{- if eq $ones 1 }}{{ $suffix = "st" }}
		{{- else if eq $ones 2 }}{{ $suffix = "nd" }}
		{{- else if eq $ones 3 }}{{ $suffix = "rd" }}
		{{- end }}
	{{- end }}
	{{- . }}{{ $suffix }}
{{- end }}

{{- /* Hook function type: func(A, ...B) (R, error). */ -}}
{{- define "hookType" -}}
	func({{ .ArgTypeListEllipsis }}) {{ .ReturnArgTypeList }}
{{- end }}

{{- /* Positional parameters: v0 A, v1 ...B. */ -}}
{{- define "params" -}}
	{{- range $i, $p := .Params }}
		{{- if $i }}, {{ end }}v{{ $i }} {{ $p.TypeStringEllipsis }}
	{{- end -}}
{{- end }}

{{- /* Positional arguments of a call: v0, v1... */ -}}
{{- define "args" -}}
	{{- range $i, $p := .Params }}
		{{- if $i }}, {{ end }}v{{ $i }}{{ if $p.Variadic }}...{{ end }}
	{{- end -}}
{{- end }}

{{- /* Named results: r0 R, r1 error. */ -}}
{{- define "results" -}}
	{{- range $i, $r := .Returns }}{{ if $i }}, {{ end }}r{{ $i }} {{ $r.TypeString }}{{ end -}}
{{- end }}

{{- /* Result variables: r0, r1. */ -}}
{{- define "resultVars" -}}
	{{- range $i, $r := .Returns }}{{ if $i }}, {{ end }}r{{ $i }}{{ end -}}
{{- end }}

{{- range $iface := .Interfaces }}
{{- $struct := $iface.StructName }}
{{- $tparams := $iface.TypeConstraint }}
{{- $targs := $iface.TypeInstantiation }}

// {{ $struct }} is a fake implementation of the {{ $iface.Name }} interface
// (from the package {{ $.Registry.SrcPkg.PkgPath }}) used for unit testing.
type {{ $struct }}{{ $tparams }} struct
{{- if not $iface.Methods }}{}{{ else }} {
	{{- range $iface.Methods }}
	// {{ .Name }}Func is an instance of a fake function object
	// controlling the behavior of the method {{ .Name }}.
	{{ .Name }}Func {{ $struct }}{{ .Name }}Func{{ $targs }}
	{{- end }}
}
{{- end }}

// New{{ $struct }} creates a new fake of the {{ $iface.Name }} interface.
// All methods panic on invocation, unless overwritten.
func New{{ $struct }}{{ $tparams }}() *{{ $struct }}{{ $targs }} {
	return &{{ $struct }}{{ $targs }}{}
}

// New{{ $struct }}From creates a new fake of the {{ $iface.Name }} interface.
// All methods delegate to the given implementation, unless overwritten.
func New{{ $struct }}From{{ $tparams }}(i {{ $src }}{{ $iface.Name }}{{ $targs }})
{{- /**/}} *{{ $struct }}{{ $targs }} {
	return &{{ $struct }}{{ $targs }}{
		{{- range $iface.Methods }}
		{{ .Name }}Func: {{ $struct }}{{ .Name }}Func{{ $targs }}{
			defaultHook: i.{{ .Name }},
		},
		{{- end }}
	}
}

{{- range $method := $iface.Methods }}
{{- $func := printf "%s%sFunc" $struct $method.Name }}
{{- $call := printf "%s%sFuncCall" $struct $method.Name }}
{{- $variadic := false }}
{{- with $method.Params }}{{ $variadic = (index . (decr (len .))).Variadic }}{{ end }}
{{- /* Fields of a call record: see "Call records" in doc.go. */ -}}
{{- $vars := " " }}
{{- range $method.Params }}{{ $vars = printf "%s%s " $vars (replaceAll "MoqParam" "" .Name) }}{{ end }}
{{- range $method.Returns }}{{ $vars = printf "%s%s " $vars (replaceAll "MoqParam" "" .Name) }}{{ end }}
{{- $taken := " Args Results " }}
{{- range $prefix := split " " "Arg Result" }}
	{{- $list := $method.Params }}
	{{- if eq $prefix "Result" }}{{ $list = $method.Returns }}{{ end }}
	{{- range $list }}
		{{- $name := replaceAll "MoqParam" "" .Name }}
		{{- $base := trimRight "0123456789" $name }}
		{{- if and ($method.Scope.NameExists $base) (not (contains (printf " %s " $base) $vars)) }}
			{{- $name = $base }}
		{{- end }}
		{{- $field := firstUpper $name }}
		{{- if matchString `^[A-Za-z]` $name }}{{ $field = exported $name }}{{ end }}
		{{- if not (matchString `^\p{Lu}` $field) }}{{ $field = printf "%s%s" $prefix $field }}{{ end }}
		{{- range split " " $taken }}
			{{- if contains (printf " %s " $field) $taken }}{{ $field = printf "%s%s" $prefix $field }}{{ end }}
		{{- end }}
		{{- $taken = printf "%s%s " $taken $field }}
	{{- end }}
{{- end }}
{{- $fields := split " " (trimSpace (trimPrefix " Args Results " $taken)) }}
{{- $results := len $method.Params }}

// {{ $func }} describes the behavior when the {{ $method.Name }} method
// of the parent {{ $struct }} instance is invoked.
type {{ $func }}{{ $tparams }} struct {
	defaultHook {{ template "hookType" $method }}
	hooks       []{{ template "hookType" $method }}
	history     []{{ $call }}{{ $targs }}
	mutex       {{ $sync }}.Mutex
}

// {{ $method.Name }} delegates to the next hook function in the queue
// and stores the parameter and result values of this invocation.
func (m *{{ $struct }}{{ $targs }}) {{ $method.Name }}({{ template "params" $method }})
{{- /**/}} {{ $method.ReturnArgTypeList }} {
	{{ if $method.Returns }}{{ template "resultVars" $method }} := {{ end -}}
	m.{{ $method.Name }}Func.nextHook()({{ template "args" $method }})
	m.{{ $method.Name }}Func.appendCall({{ $call }}{{ $targs }}{
		{{- range $i, $p := $method.Params }}{{ if $i }}, {{ end }}v{{ $i }}{{ end }}
		{{- if and $method.Params $method.Returns }}, {{ end }}
		{{- template "resultVars" $method -}}
	})
	return {{ template "resultVars" $method }}
}

// SetDefaultHook sets function that is called when the {{ $method.Name }} method
// of the parent {{ $struct }} instance is invoked and the hook queue is empty.
func (f *{{ $func }}{{ $targs }}) SetDefaultHook(hook {{ template "hookType" $method }}) {
	f.defaultHook = hook
}

// PushHook adds a function to the end of hook queue.
// Each invocation of the {{ $method.Name }} method of the parent {{ $struct }} instance
// invokes the hook at the front of the queue and discards it.
// After the queue is empty, the default hook function is invoked for any future action.
func (f *{{ $func }}{{ $targs }}) PushHook(hook {{ template "hookType" $method }}) {
	f.mutex.Lock()
	f.hooks = append(f.hooks, hook)
	f.mutex.Unlock()
}

// SetDefaultReturn calls SetDefaultHook with a function that returns the given values.
func (f *{{ $func }}{{ $targs }}) SetDefaultReturn({{ template "results" $method }}) {
	f.SetDefaultHook({{ template "hookType" $method }} {
		return {{ template "resultVars" $method }}
	})
}

// PushReturn calls PushHook with a function that returns the given values.
func (f *{{ $func }}{{ $targs }}) PushReturn({{ template "results" $method }}) {
	f.PushHook({{ template "hookType" $method }} {
		return {{ template "resultVars" $method }}
	})
}

func (f *{{ $func }}{{ $targs }}) nextHook() {{ template "hookType" $method }} {
	f.mutex.Lock()
	defer f.mutex.Unlock()

	if len(f.hooks) == 0 {
		if f.defaultHook == nil {
			panic("unexpected invocation of {{ $struct }}.{{ $method.Name }}")
		}
		return f.defaultHook
	}

	hook := f.hooks[0]
	f.hooks = f.hooks[1:]
	return hook
}

func (f *{{ $func }}{{ $targs }}) appendCall(r0 {{ $call }}{{ $targs }}) {
	f.mutex.Lock()
	f.history = append(f.history, r0)
	f.mutex.Unlock()
}

// History returns a sequence of {{ $call }} objects
// describing the invocations of this function.
func (f *{{ $func }}{{ $targs }}) History() []{{ $call }}{{ $targs }} {
	f.mutex.Lock()
	history := make([]{{ $call }}{{ $targs }}, len(f.history))
	copy(history, f.history)
	f.mutex.Unlock()

	return history
}

// {{ $call }} is an object that describes an invocation
// of method {{ $method.Name }} on an instance of {{ $struct }}.
type {{ $call }}{{ $tparams }} struct
{{- if not (or $method.Params $method.Returns) }}{}{{ else }} {
	{{- range $i, $p := $method.Params }}
	{{- if $p.Variadic }}
	// {{ index $fields $i }} is a slice containing the values of the variadic arguments
	// passed to this method invocation.
	{{- else }}
	// {{ index $fields $i }} is the value of the {{ template "ordinal" (incr $i) }} argument
	// passed to this method invocation.
	{{- end }}
	{{ index $fields $i }} {{ $p.TypeString }}
	{{- end }}
	{{- range $i, $r := $method.Returns }}
	// {{ index $fields (add $results $i) }} is the value of the {{ template "ordinal" (incr $i) }} result
	// returned from this method invocation.
	{{ index $fields (add $results $i) }} {{ $r.TypeString }}
	{{- end }}
}
{{- end }}

{{- if $variadic }}
{{- $last := decr (len $method.Params) }}

// Args returns an interface slice containing the arguments of this invocation.
// The variadic slice argument is flattened in this array such that
// one positional argument and three variadic arguments
// would result in a slice of four, not two.
func (c {{ $call }}{{ $targs }}) Args() []any {
	trailing := []any{}
	for _, val := range c.{{ index $fields $last }} {
		trailing = append(trailing, val)
	}

	return append([]any{
		{{- range $i, $p := $method.Params }}
			{{- if lt $i $last }}{{ if $i }}, {{ end }}c.{{ index $fields $i }}{{ end }}
		{{- end -}}
	}, trailing...)
}
{{- else }}

// Args returns an interface slice containing the arguments of this invocation.
func (c {{ $call }}{{ $targs }}) Args() []any {
	return []any{
		{{- range $i, $p := $method.Params }}{{ if $i }}, {{ end }}c.{{ index $fields $i }}{{ end -}}
	}
}
{{- end }}

// Results returns an interface slice containing the results of this invocation.
func (c {{ $call }}{{ $targs }}) Results() []any {
	return []any{
		{{- range $i, $r := $method.Returns }}{{ if $i }}, {{ end }}c.{{ index $fields (add $results $i) }}{{ end -}}
	}
}
{{- end }}
{{- end }}
